# Fashion Scraper Argentina — root env template (decouple-services-postgres,
# scoped correction closing verify-report CRITICAL-1). Copy to `.env` (already
# gitignored) and fill in real values, OR let INSTALAR_Y_CORRER.bat /
# Ejecutar_instalar.sh generate `.env` for you from a portable local Postgres.
#
# The backend (Spring Boot) and Python ML subprocess both read these directly
# from the process environment — never from an in-app `.env` parser. The
# launcher scripts source this file and export each var into the process
# environment of every service they start.
#
# Frontend note: `VITE_API_BASE_URL` is a SEPARATE var, documented in its own
# template at frontend/.env.example (Vite only reads vars from frontend/.env*,
# not from this root file) — not duplicated here.

# ── Database (REQUIRED — backend fails fast at startup if unset) ───────────
# Java/Spring needs the `jdbc:` prefix. Python (psycopg2, via
# PythonRunner.toPsycopgDsn) does NOT understand `jdbc:` — the Java backend
# automatically strips it before passing DATABASE_URL to the Python
# subprocess, so set this ONE value in the `jdbc:` form; nothing else to do.
DATABASE_URL=jdbc:postgresql://localhost:5432/scraper

# Postgres role used by both Java (HikariCP) and Python (psycopg2).
DATABASE_USERNAME=postgres

# May be an EMPTY string for local trust-auth Postgres (e.g. the installer's
# portable _tools/pgsql, provisioned with `initdb -A trust`) — an explicit
# empty value is NOT treated as "missing" by the backend's fail-fast guard,
# only a fully unset var is.
DATABASE_PASSWORD=postgres

# ── CORS (REQUIRED — backend fails fast at startup if unset) ───────────────
# Comma-separated list of allowed frontend origins, e.g.
# https://app.example.com,https://admin.example.com
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173

# ── ML model cache (REQUIRED by the ML subprocess; independent of DATABASE_URL) ──
# Root directory for the zero-shot vision model cache (HF_HOME derives from
# <SCRAPER_MODELS_ROOT>/marqo). Resolved independently of the DB location —
# works the same whether Postgres is local or remote.
SCRAPER_MODELS_ROOT=./scraper/_models

# ── Optional ─────────────────────────────────────────────────────────────
# Backend is API-only; unset by default (no-op). If set, the backend opens
# this URL in the local browser once Tomcat is ready — point it at the
# frontend's real origin if you want that convenience.
# APP_OPEN_URL=http://localhost:3000

# ── Frontend preview URL (interactive-cli-launcher) ─────────────────────────
# menu.ps1 / menu.sh start the frontend as its own service via
# `npm run preview -- --port 5173 --strictPort` (NOT `npm run dev`, NOT the
# backend's :3000 — the backend is API-only and serves no SPA). The "open
# dashboard" menu action always targets this URL. Must match the port in
# APP_CORS_ALLOWED_ORIGINS above (http://localhost:5173) or CORS will
# reject the frontend's requests.

# Explicitly opt into local development fallbacks (application-dev.properties):
# when set to `dev`, the backend no longer requires DATABASE_URL/USERNAME/
# PASSWORD/APP_CORS_ALLOWED_ORIGINS above — it falls back to
# jdbc:postgresql://localhost:5432/scraper + postgres/postgres +
# http://localhost:5173. Leave unset (default profile) for a real fail-fast
# start, including the installer's generated `.env` which always sets every
# required var explicitly and never relies on this profile.
# SPRING_PROFILES_ACTIVE=dev

# Rolling log directory override (backend). Defaults to `logs/` next to the
# jar when unset.
# LOG_DIR=./scraper/logs

# ── Autenticación (user-accounts-and-roles, fase 1) — REQUERIDAS ──────────
# Las cinco fallan el arranque si faltan, y ADEMÁS si están en blanco. Eso las
# diferencia de DATABASE_PASSWORD, que sí admite vacío para el trust-auth
# local: no existe despliegue donde un secreto de firma vacío sea una decisión.
#
# OJO: esta fase NO cierra ninguna puerta. Se emiten tokens y nadie los exige
# todavía; todos los endpoints siguen tan abiertos como antes.

# Secreto de firma HS256, mínimo 32 bytes. El instalador GENERA uno propio por
# instalación y no lo vuelve a tocar aunque regeneres el .env — rotarlo cierra
# todas las sesiones sin explicar por qué. El valor de acá abajo es un
# marcador, no un secreto: si alguna vez aparece en un .env real, el backend
# está firmando con algo que conoce cualquiera que clone el repo.
AUTH_JWT_SECRET=generado-por-el-instalador

# Cuenta admin inicial. La password la elegís VOS: el backend se niega a
# sembrar mientras siga diciendo el placeholder de abajo, y avisa fuerte.
#
# Y una consecuencia que conviene saber de antemano: el seeder NUNCA pisa un
# hash existente, así que cambiar esta variable y reiniciar NO cambia la
# password de una cuenta ya creada. Para eso hay que ir a la base a mano.
ADMIN_BOOTSTRAP_USERNAME=admin
ADMIN_BOOTSTRAP_PASSWORD=cambiame-por-una-password-real

# Cuenta de servicio del CLI (es_servicio=TRUE, sin email, no reseteable por
# invariante de esquema). Nadie tipea esta password: el CLI la lee de acá. La
# genera el instalador y queda fija, igual que el secreto de firma.
CLI_SERVICE_ACCOUNT_USERNAME=cli-service
CLI_SERVICE_ACCOUNT_PASSWORD=generado-por-el-instalador

# ── Reseteo de contraseña (user-accounts-and-roles, fase 2) — OPCIONALES ───
# El canal por defecto escribe el link al log y NO necesita nada configurado.
# Es deliberado: este proyecto se instala en una laptop, y exigir un servidor de
# mail para recuperar una contraseña dejaría la función fuera de alcance justo
# para las instalaciones de un solo usuario que más la necesitan.
#
# OJO con el canal `console`: pone un link con un token VIVO adentro de
# scraper.log. Es un trade-off real y acotado por los dos lados — el token es de
# un solo uso y vence en 30 minutos, y quien puede leer scraper.log ya puede
# leer este mismo .env, que tiene la password de la base y el secreto de firma.
# Si tu log es una frontera más débil que este archivo, elegí `smtp`.
PASSWORD_RESET_CHANNEL=console

# Base del link. Sin frontend todavía no lleva a ninguna página, pero el token
# que trae sirve igual contra POST /api/auth/password-reset/confirm.
PASSWORD_RESET_LINK_BASE=http://localhost:5173

# SMTP: SÓLO se exigen si PASSWORD_RESET_CHANNEL=smtp. Con `console` podés
# dejarlas en blanco y el backend arranca igual. Si elegís smtp y falta una,
# el arranque aborta nombrándola — un relay a medio configurar falla adentro de
# un despacho asincrónico, donde no lo ve nadie, y el usuario recibe el mismo
# "fijate tu mail" de siempre.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=

# ── LLM Catalog Agent (llm-catalog-nlp) — OPTIONAL, safe local defaults ─────
# Provider-pluggable chat agent over the catalog ("Ask Agent" button in the ML
# panel). All four vars are OPTIONAL: they are NOT in RequiredEnvVarsGuard, so
# the backend starts without them and falls back to a local Ollama on
# localhost:11434. Set them only to point at a different provider/model/host.
# The UI model selector overrides LLM_MODEL per-request (no code/env change to
# switch models). Full guide: docs/LLM_AGENT_SETUP.md.
# LLM_PROVIDER=openai_compat
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=qwen3:14b
# LLM_API_KEY=
