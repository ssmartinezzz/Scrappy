# decouple-services-postgres, Batch 3 (task 3.5): API base URL for the
# frontend's fetch client (frontend/src/api.js). `vite dev` still falls back
# to the dev-server proxy (vite.config.js forwards /api to
# http://localhost:3000) when this is absent, but a *production* `vite build`
# fails fast without it (VITE_API_BASE_URL Build-Time Export Ordering,
# native-cli-installer). Active by default so the CLI's template-driven
# `.env` generation (cli/core/builder.py, mirroring the root `.env.example`
# contract) always populates it before `npm run build` — set to the
# backend's real origin for any deployment where the frontend is served from
# a different origin than the API (matches the backend's
# APP_CORS_ALLOWED_ORIGINS allow-list, design D6).
VITE_API_BASE_URL=http://localhost:3000
