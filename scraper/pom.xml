<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>ar.scraper</groupId>
    <artifactId>fashion-scraper</artifactId>
    <version>1.0.1</version>
    <packaging>jar</packaging>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/>
    </parent>

    <properties>
        <java.version>21</java.version>
        <!-- Surefire's own user property, so `-DforkCount=1` still overrides it. Forks
             are isolated: PostgresTestBase starts one Postgres per JVM. Threads inside
             one JVM are not — they share the DB that truncateAll wipes. -->
        <forkCount>4</forkCount>
        <playwright.version>1.44.0</playwright.version>
        <resilience4j.version>2.2.0</resilience4j.version>
        <!-- Empirically verified against Maven Central in PR0 (see docs/ADR / apply-progress notes) -->
        <allure.version>2.29.1</allure.version>
        <!-- BouncyCastle backs Argon2PasswordEncoder. Boot's BOM does not manage it,
             so it is pinned here — an unpinned version is a build that changes under
             you. 1.76 carried CVSS 9.3 advisories; 1.86 is the latest 1.x. -->
        <bouncycastle.version>1.86</bouncycastle.version>
        <!-- HS256 access tokens. Boot's BOM does not manage a JWT library
             either, so this is pinned for the same reason as BouncyCastle. -->
        <nimbus.jwt.version>9.37.3</nimbus.jwt.version>
        <!-- Flyway (incl. flyway-database-postgresql) and the PostgreSQL driver are managed
             by Boot. Three managed versions are overridden to their first patch without
             HIGH/CRITICAL advisories (the Dependency Audit gate):
             - Tomcat: Boot 4.1.1 manages 11.0.24 (CVSS 9.8, fixed in 11.0.25);
             - Jackson 3 (tools.jackson, Spring's HTTP layer): 3.1.5 (7.5, fixed in 3.1.7);
             - Jackson 2 (com.fasterxml.jackson, used directly by the code): 2.21.5, 2.21.7
               carries the fixes.
             Drop each override once Boot manages that version or newer. -->
        <tomcat.version>11.0.26</tomcat.version>
        <jackson-bom.version>3.1.7</jackson-bom.version>
        <jackson-2-bom.version>2.21.7</jackson-2-bom.version>
        <!-- opencsv 5.9 drags in commons-beanutils 1.9.4 (CVSS 8.8, fixed in 1.11.0). -->
        <commons-beanutils.version>1.11.0</commons-beanutils.version>
        <!-- Boot's BOM does not manage ArchUnit either, so it is pinned
             here like BouncyCastle and Nimbus above. -->
        <archunit.version>1.5.0</archunit.version>
        <!-- Pinned below Boot 4.1's 1.18.46 on purpose: that release does not copy
             @JsonProperty from a field onto its generated getter, so CatalogoDtos.Ml
             serializes "zscore" next to "zScore". Caught by
             ApiEnvelopeSerializationTest.productRowKeepsTheHistoricalKeys and
             HttpJsonBodyTest (red with -Dlombok.version=1.18.46). 1.18.38 also
             supports JDK 24 (>= 1.18.36). -->
        <lombok.version>1.18.38</lombok.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>commons-beanutils</groupId>
                <artifactId>commons-beanutils</artifactId>
                <version>${commons-beanutils.version}</version>
            </dependency>
            <dependency>
                <groupId>io.qameta.allure</groupId>
                <artifactId>allure-bom</artifactId>
                <version>${allure.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- Spring Boot Web (Tomcat embebido) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-cache</artifactId>
        </dependency>
        <dependency>
            <groupId>com.github.ben-manes.caffeine</groupId>
            <artifactId>caffeine</artifactId>
        </dependency>

        <!-- Playwright -->
        <dependency>
            <groupId>com.microsoft.playwright</groupId>
            <artifactId>playwright</artifactId>
            <version>${playwright.version}</version>
        </dependency>

        <!-- Jackson (ya incluido por Spring Boot) -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>

        <!-- OpenCSV -->
        <dependency>
            <groupId>com.opencsv</groupId>
            <artifactId>opencsv</artifactId>
            <version>5.9</version>
        </dependency>

        <!-- Declarada: el código la usa directo; antes llegaba sólo transitiva vía opencsv -->
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-lang3</artifactId>
        </dependency>

        <!-- JDBC + HikariCP (default pool in Spring Boot) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
        </dependency>

        <!-- Retry with backoff, used programmatically (no AOP starter) -->
        <dependency>
            <groupId>io.github.resilience4j</groupId>
            <artifactId>resilience4j-retry</artifactId>
            <version>${resilience4j.version}</version>
        </dependency>

        <!-- PostgreSQL driver -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
        </dependency>

        <!-- Flyway: versioned schema migrations, replaces runtime initEn/migrarColumna bootstrap -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-flyway</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>

        <!-- Argon2id password hashing (user-accounts-and-roles slice 1).
             spring-security-crypto + BouncyCastle instead of a native binding:
             this project ships as a portable Windows installer, and a JNI
             library would have to be vendored per-architecture. Pure Java has
             no such tail. The full spring-boot-starter-security is not pulled
             in — slice 1 has no filter chain and no HTTP surface at all. -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-crypto</artifactId>
        </dependency>
        <dependency>
            <groupId>org.bouncycastle</groupId>
            <artifactId>bcprov-jdk18on</artifactId>
            <version>${bouncycastle.version}</version>
        </dependency>

        <!-- Spring Security (slice 7). Pulled in only now, with the filter chain:
             adding it earlier would have switched on Boot's default chain and
             gated everything by accident, which is precisely the change this
             slice makes deliberately and visibly. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- SMTP delivery for the opt-in password-reset channel (slice 6). The
             console channel is the default and needs none of this; the starter
             is here so choosing SMTP is a config change rather than a rebuild.
             Version managed by spring-boot-starter-parent. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-mail</artifactId>
        </dependency>

        <!-- JWT (user-accounts-and-roles slice 2). Nimbus rather than jjwt: one
             artifact instead of three, and it is the library Spring Security
             itself uses, so a later move to the starter finds it already here. -->
        <dependency>
            <groupId>com.nimbusds</groupId>
            <artifactId>nimbus-jose-jwt</artifactId>
            <version>${nimbus.jwt.version}</version>
        </dependency>

        <!-- Testing (JUnit 5 + Mockito) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- @WebMvcTest and MockMvc moved out of spring-boot-starter-test in Boot 4. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Testcontainers Postgres — write-path/concurrency test seam (Batch 1, task 1.3/1.4).
             Superseded by the full PostgresTestBase hybrid seam in Batch 4 (task 4.5). -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-postgresql</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Allure JUnit5 integration (version resolved via allure-bom import above) -->
        <dependency>
            <groupId>io.qameta.allure</groupId>
            <artifactId>allure-junit5</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- AspectJ weaver: required for @Step / declarative annotation runtime capture -->
        <dependency>
            <groupId>org.aspectj</groupId>
            <artifactId>aspectjweaver</artifactId>
            <version>${aspectj.version}</version>
            <scope>test</scope>
        </dependency>

        <!-- ArchUnit: enforces backend layering as executable tests (decouple-backend-layers). -->
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <version>${archunit.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- JDK 23+ does not run annotation processors found on the classpath. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>0.8.11</version>
                <configuration>
                    <excludes>
                        <exclude>ar/scraper/pages/**</exclude>
                        <exclude>ar/scraper/scrapers/**</exclude>
                        <exclude>ar/scraper/App.class</exclude>
                    </excludes>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>test</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <!-- Bundles docs/openapi.yaml onto the classpath for OpenApiDocumentController.
                 Target prefix is "contract/", never static/public/resources/META-INF/resources,
                 which Boot would serve directly and bypass ApiRoutePolicy. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <executions>
                    <execution>
                        <id>copy-openapi-contract</id>
                        <phase>generate-resources</phase>
                        <goals>
                            <goal>copy-resources</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.build.outputDirectory}/contract</outputDirectory>
                            <overwrite>true</overwrite>
                            <resources>
                                <resource>
                                    <directory>${project.basedir}/../docs</directory>
                                    <includes>
                                        <include>openapi.yaml</include>
                                    </includes>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <mainClass>ar.scraper.App</mainClass>
                    <!-- Excluir firmas para evitar conflictos en fat JAR -->
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <!-- version managed by spring-boot-starter-parent -->
                <configuration>
                    <!--
                        @{argLine} uses Maven's LATE property expansion (resolved at the
                        `test` phase execution), which preserves the JaCoCo javaagent string
                        written by jacoco:prepare-agent during the `initialize` phase.
                        NEVER change this to ${argLine} (eager interpolation) — that drops
                        the JaCoCo agent silently and coverage reports empty while tests
                        still pass.
                    -->
                    <argLine>@{argLine} -javaagent:"${settings.localRepository}/org/aspectj/aspectjweaver/${aspectj.version}/aspectjweaver-${aspectj.version}.jar"</argLine>
                    <systemPropertyVariables>
                        <allure.results.directory>${project.build.directory}/allure-results</allure.results.directory>
                        <!-- decouple-services-postgres scoped correction: activates the `test`
                             Spring profile for the whole surefire JVM so RequiredEnvVarsGuard
                             (and any future @SpringBootTest) skips the fail-fast required-env-var
                             check without needing real DATABASE_URL/etc. in the test environment. -->
                        <spring.profiles.active>test</spring.profiles.active>
                        <!--
                            scrape-run-persistence-and-resume, slice 1. DO NOT REMOVE as
                            "unnecessary": without it this suite is not reproducible
                            between machines.

                            pgjdbc sends `SET TimeZone` with the JVM's default zone when
                            it connects, so a zoneless literal cast to `timestamptz` —
                            `'2026-08-25 10:00:00'::timestamptz` — lands at 13:00Z on a
                            developer machine at -03 and at 10:00Z on CI (ubuntu-latest,
                            UTC). Same source, two different instants, and the only
                            variable is who ran it. A timestamp test tuned green locally
                            can go red on CI, and a genuine CI red is then trivially
                            dismissed as flakiness.

                            Pinning UTC does not introduce a new regime: CI already runs
                            this whole suite under UTC and green. It makes the local run
                            behave like CI.

                            This does NOT replace writing an explicit offset in the
                            literals themselves. They fix different things — this fixes
                            reproducibility across machines, the offset fixes each test's
                            correctness and survives being run from an IDE, where surefire
                            is not involved.
                        -->
                        <user.timezone>UTC</user.timezone>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
            <plugin>
                <groupId>io.qameta.allure</groupId>
                <artifactId>allure-maven</artifactId>
                <version>2.15.2</version>
                <configuration>
                    <resultsDirectory>${project.build.directory}/allure-results</resultsDirectory>
                    <reportVersion>${allure.version}</reportVersion>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
