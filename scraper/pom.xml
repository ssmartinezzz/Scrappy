<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>ar.scraper</groupId>
    <artifactId>fashion-scraper</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.2.5</version>
        <relativePath/>
    </parent>

    <properties>
        <java.version>21</java.version>
        <playwright.version>1.44.0</playwright.version>
        <!-- Empirically verified against Maven Central in PR0 (see docs/ADR / apply-progress notes) -->
        <allure.version>2.29.1</allure.version>
        <aspectj.version>1.9.24</aspectj.version>
        <testcontainers.version>1.21.4</testcontainers.version>
        <!-- BouncyCastle backs Argon2PasswordEncoder. Spring Boot 3.2.5's BOM
             does not manage it, so it is pinned here like flyway-database-postgresql
             below — an unpinned version is a build that changes under you. -->
        <bouncycastle.version>1.76</bouncycastle.version>
        <!-- HS256 access tokens. Boot 3.2.5's BOM does not manage a JWT library
             either, so this is pinned for the same reason as BouncyCastle. -->
        <nimbus.jwt.version>9.37.3</nimbus.jwt.version>
        <!-- Spring Boot 3.2.5's dependencyManagement does not pin flyway-database-postgresql
             (added to Boot's managed BOM in later 3.2.x/3.3 lines) — pin explicitly, matching
             the flyway-core version Boot 3.2.5 DOES manage (10.10.0). -->
        <flyway.version>10.10.0</flyway.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>io.qameta.allure</groupId>
                <artifactId>allure-bom</artifactId>
                <version>${allure.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.testcontainers</groupId>
                <artifactId>testcontainers-bom</artifactId>
                <version>${testcontainers.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- Spring Boot Web (Tomcat embebido) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Playwright -->
        <dependency>
            <groupId>com.microsoft.playwright</groupId>
            <artifactId>playwright</artifactId>
            <version>${playwright.version}</version>
        </dependency>

        <!-- Jackson (ya incluido por Spring Boot) -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>

        <!-- OpenCSV -->
        <dependency>
            <groupId>com.opencsv</groupId>
            <artifactId>opencsv</artifactId>
            <version>5.9</version>
        </dependency>

        <!-- JDBC + HikariCP (default pool in Spring Boot 3.2) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
        </dependency>

        <!-- PostgreSQL driver -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
        </dependency>

        <!-- Flyway: versioned schema migrations, replaces runtime initEn/migrarColumna bootstrap -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
            <version>${flyway.version}</version>
        </dependency>

        <!-- Argon2id password hashing (user-accounts-and-roles slice 1).
             spring-security-crypto + BouncyCastle instead of a native binding:
             this project ships as a portable Windows installer, and a JNI
             library would have to be vendored per-architecture. Pure Java has
             no such tail. The full spring-boot-starter-security is not pulled
             in — slice 1 has no filter chain and no HTTP surface at all. -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-crypto</artifactId>
        </dependency>
        <dependency>
            <groupId>org.bouncycastle</groupId>
            <artifactId>bcprov-jdk18on</artifactId>
            <version>${bouncycastle.version}</version>
        </dependency>

        <!-- Spring Security (slice 7). Pulled in only now, with the filter chain:
             adding it earlier would have switched on Boot's default chain and
             gated everything by accident, which is precisely the change this
             slice makes deliberately and visibly. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- SMTP delivery for the opt-in password-reset channel (slice 6). The
             console channel is the default and needs none of this; the starter
             is here so choosing SMTP is a config change rather than a rebuild.
             Version managed by spring-boot-starter-parent. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-mail</artifactId>
        </dependency>

        <!-- JWT (user-accounts-and-roles slice 2). Nimbus rather than jjwt: one
             artifact instead of three, and it is the library Spring Security
             itself uses, so a later move to the starter finds it already here. -->
        <dependency>
            <groupId>com.nimbusds</groupId>
            <artifactId>nimbus-jose-jwt</artifactId>
            <version>${nimbus.jwt.version}</version>
        </dependency>

        <!-- Testing (JUnit 5 + Mockito) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Testcontainers Postgres — write-path/concurrency test seam (Batch 1, task 1.3/1.4).
             Superseded by the full PostgresTestBase hybrid seam in Batch 4 (task 4.5). -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>postgresql</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Allure JUnit5 integration (version resolved via allure-bom import above) -->
        <dependency>
            <groupId>io.qameta.allure</groupId>
            <artifactId>allure-junit5</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- AspectJ weaver: required for @Step / declarative annotation runtime capture -->
        <dependency>
            <groupId>org.aspectj</groupId>
            <artifactId>aspectjweaver</artifactId>
            <version>${aspectj.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>0.8.11</version>
                <configuration>
                    <excludes>
                        <exclude>ar/scraper/pages/**</exclude>
                        <exclude>ar/scraper/scrapers/**</exclude>
                        <exclude>ar/scraper/App.class</exclude>
                    </excludes>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>test</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <mainClass>ar.scraper.App</mainClass>
                    <!-- Excluir firmas para evitar conflictos en fat JAR -->
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <!-- version managed by spring-boot-starter-parent -->
                <configuration>
                    <!--
                        @{argLine} uses Maven's LATE property expansion (resolved at the
                        `test` phase execution), which preserves the JaCoCo javaagent string
                        written by jacoco:prepare-agent during the `initialize` phase.
                        NEVER change this to ${argLine} (eager interpolation) — that drops
                        the JaCoCo agent silently and coverage reports empty while tests
                        still pass.
                    -->
                    <argLine>@{argLine} -javaagent:"${settings.localRepository}/org/aspectj/aspectjweaver/${aspectj.version}/aspectjweaver-${aspectj.version}.jar"</argLine>
                    <systemPropertyVariables>
                        <allure.results.directory>${project.build.directory}/allure-results</allure.results.directory>
                        <!-- decouple-services-postgres scoped correction: activates the `test`
                             Spring profile for the whole surefire JVM so RequiredEnvVarsGuard
                             (and any future @SpringBootTest) skips the fail-fast required-env-var
                             check without needing real DATABASE_URL/etc. in the test environment. -->
                        <spring.profiles.active>test</spring.profiles.active>
                        <!--
                            scrape-run-persistence-and-resume, slice 1. DO NOT REMOVE as
                            "unnecessary": without it this suite is not reproducible
                            between machines.

                            pgjdbc sends `SET TimeZone` with the JVM's default zone when
                            it connects, so a zoneless literal cast to `timestamptz` —
                            `'2026-08-25 10:00:00'::timestamptz` — lands at 13:00Z on a
                            developer machine at -03 and at 10:00Z on CI (ubuntu-latest,
                            UTC). Same source, two different instants, and the only
                            variable is who ran it. A timestamp test tuned green locally
                            can go red on CI, and a genuine CI red is then trivially
                            dismissed as flakiness.

                            Pinning UTC does not introduce a new regime: CI already runs
                            this whole suite under UTC and green. It makes the local run
                            behave like CI.

                            This does NOT replace writing an explicit offset in the
                            literals themselves. They fix different things — this fixes
                            reproducibility across machines, the offset fixes each test's
                            correctness and survives being run from an IDE, where surefire
                            is not involved.
                        -->
                        <user.timezone>UTC</user.timezone>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
            <plugin>
                <groupId>io.qameta.allure</groupId>
                <artifactId>allure-maven</artifactId>
                <version>2.15.2</version>
                <configuration>
                    <resultsDirectory>${project.build.directory}/allure-results</resultsDirectory>
                    <reportVersion>${allure.version}</reportVersion>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
