          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT sitio_key AS \"Sitio\",\n       count(*) AS \"Activos\",\n       round(100.0 * count(*) FILTER (WHERE categoria IS NULL OR categoria = 'Otros') / count(*), 1) AS \"% sin categoría\",\n       round(100.0 * count(*) FILTER (WHERE marca IS NULL) / count(*), 1) AS \"% sin marca\"\nFROM productos WHERE activo IS NOT FALSE\nGROUP BY 1 ORDER BY 3 DESC"
        }
