    {
      "type": "table",
      "id": 8,
      "title": "Estado por sitio (última vez que corrió)",
      "description": "Arriba quedan los que fallaron o trajeron 0, después los que más cayeron contra su corrida anterior. 'Vez anterior' es la última corrida completa de ESE sitio, no la corrida global anterior. 'Cortado' = la paginación se cortó por un error: esos productos se guardaron pero no se desactivó nada del sitio.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "scrappy-postgres"
      },
      "gridPos": {
        "x": 0,
        "y": 15,
        "w": 24,
        "h": 11
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "scrappy-postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH ult AS (\n  SELECT DISTINCT ON (sitio_key) sitio_key,\n         -- DONE with an error = pagination cut mid-way: the products are partial.\n         CASE WHEN status = 'DONE' AND error IS NOT NULL THEN 'PARTIAL' ELSE status END AS status,\n         productos_count, started_at, finished_at, error\n  FROM scrape_run_site\n  WHERE started_at IS NOT NULL\n  ORDER BY sitio_key, started_at DESC\n), prev AS (\n  SELECT DISTINCT ON (s.sitio_key) s.sitio_key, s.productos_count\n  FROM scrape_run_site s JOIN ult u USING (sitio_key)\n  WHERE s.status = 'DONE' AND s.error IS NULL AND s.started_at < u.started_at\n  ORDER BY s.sitio_key, s.started_at DESC\n)\nSELECT u.sitio_key AS \"Sitio\",\n       u.status AS \"Estado\",\n       u.productos_count AS \"Productos\",\n       p.productos_count AS \"Vez anterior\",\n       CASE WHEN p.productos_count > 0\n            THEN round(100.0 * (u.productos_count - p.productos_count) / p.productos_count, 1)\n       END AS \"Variación %\",\n       round(extract(epoch FROM u.finished_at - u.started_at)::numeric / 60, 1) AS \"Minutos\",\n       u.started_at AS \"Corrió\",\n       u.error AS \"Error\"\nFROM ult u LEFT JOIN prev p USING (sitio_key)\nWHERE u.sitio_key IN (${sitio:sqlstring})\nORDER BY (u.status IN ('ERROR', 'PARTIAL') OR u.productos_count = 0) DESC,\n         CASE WHEN p.productos_count > 0\n              THEN (u.productos_count - p.productos_count)::numeric / p.productos_count\n         END ASC NULLS LAST,\n         u.sitio_key"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "filterable": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Estado"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "DONE": {
                        "color": "green",
                        "text": "OK"
                      },
                      "PARTIAL": {
                        "color": "orange",
                        "text": "Cortado"
                      },
                      "COMPLETED": {
                        "color": "green",
                        "text": "Completa"
                      },
                      "ERROR": {
                        "color": "red",
                        "text": "Error"
                      },
                      "SKIPPED": {
                        "color": "text",
                        "text": "Salteado"
                      },
                      "RUNNING": {
                        "color": "blue",
                        "text": "Corriendo"
                      },
                      "PENDING": {
                        "color": "text",
                        "text": "Pendiente"
                      },
                      "CANCELLED": {
                        "color": "orange",
                        "text": "Cancelada"
                      },
                      "INTERRUPTED": {
                        "color": "orange",
                        "text": "Interrumpida"
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              },
              {
                "id": "custom.width",
                "value": 110
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Variación %"
            },
            "properties": [
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "red",
