            "type": "grafana-postgresql-datasource",
            "uid": "scrappy-postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT count(*) FILTER (WHERE status = 'COMPLETED')   AS \"Completas\",\n       count(*) FILTER (WHERE status = 'CANCELLED')   AS \"Canceladas\",\n       count(*) FILTER (WHERE status = 'INTERRUPTED') AS \"Interrumpidas\",\n       count(*) FILTER (WHERE status = 'ERROR')       AS \"Con error\"\nFROM scrape_run WHERE $__timeFilter(started_at)"
        }
      ],
