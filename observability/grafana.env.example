# Copied to observability/grafana.env (gitignored) by scripts/observability.sh,
# which fills both passwords with random values the first time. Not the root
# .env on purpose: the CLI regenerates that one and drops keys it doesn't know.

# Grafana login (user: admin). Only read on Grafana's first boot.
GRAFANA_ADMIN_PASSWORD=

# Password of the read-only `grafana_ro` Postgres login. Re-applied on every `up`.
GRAFANA_DB_PASSWORD=

# Where Postgres is, seen from inside the Grafana container.
#   native install / scripts/dev-db.sh: host.docker.internal
#   `observability.sh up --stack`:      postgres (set automatically)
GRAFANA_DB_HOST=host.docker.internal
GRAFANA_DB_PORT=5432
GRAFANA_DB_NAME=scraper

# http://127.0.0.1:3001 by default. 0.0.0.0 exposes it to the LAN.
GRAFANA_BIND_HOST=127.0.0.1
GRAFANA_PORT=3001
